# Runtime
NODE_ENV=production
APP_MODE=production
APP_URL="https://vyapari-nestam-business-os.vercel.app"

# AI
# Server-side only. Never expose this with a VITE_ prefix.
GEMINI_API_KEY=""

# Firebase / Google Authentication
# Client Firebase config currently comes from firebase-applet-config.json.
# Add Vercel domains in Firebase Authentication -> Settings -> Authorized domains.
FIREBASE_PROJECT_ID="vyapari-nestam-crm"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Google OAuth / Workspace APIs
# Keep scopes reviewed and least-privilege before public production.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Supabase SaaS metadata store
# Server-side only. Never expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Meta WhatsApp Business Cloud API
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_APP_SECRET=""

# Server-side encryption for integration credentials
# Required in production. Use at least 32 random bytes.
ENCRYPTION_SECRET=""

# Internal scheduled jobs
# Vercel Cron sends Authorization: Bearer $CRON_SECRET when configured.
CRON_SECRET=""
